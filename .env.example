# Copy to .env for local development. .env is gitignored; never commit a real key.
# On Railway these are set in the service's Variables tab instead.

# Powers POST /api/generate (what-beats-this, character-match, universes-colliding,
# espionage, bureaucracy, interview-beyond). Without it those six show a
# "needs a key" state and the rest of the site is unaffected.
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile.
# GROQ_MODEL=qwen/qwen3.8-27b

# Optional, for testing only: point the generator at a different OpenAI-shaped endpoint.
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# Powers /atmosphere/ (both modes) through GET /api/photos. Free, instant, no
# approval: make a Pexels account, then request a key at
# https://www.pexels.com/api/ — you get it on the spot. Free tier is 200
# requests an hour and 20,000 a month; this route caches each search for an
# hour, so a hub this size will not come close. Without it /atmosphere/ shows
# a "needs a key" panel and the rest of the site is unaffected.
PEXELS_API_KEY=

# Shared storage for /message-in-a-bottle/ and /who-else-is-here/.
#
# These two are the only toys that remember anything between visitors, and
# they use SQLite through node:sqlite, which is built into Node — no
# dependency was added. It needs Node 24+, which is why package.json now
# says so.
#
# In production the database lives on the Railway volume mounted at /data,
# so it survives a redeploy. Nothing needs setting: the store tries
# DATA_DIR, then /data, then ./.data beside the server, and uses the first
# one it can write to. Set this only to put the file somewhere else.
#
# If none of them is writable the two toys show an honest "no shared
# storage" panel and the other ninety-four are unaffected.
# DATA_DIR=/data
